#!/usr/bin/env zsh
# hub-fzf — list locally cached/downloaded models, newest first.
# Usage: hub-fzf-local <hf|ms>   → display TSV on stdout (no network).
#
# Layouts understood:
#   hf: $HF_HUB_CACHE/models--org--name        (or $HF_HOME/hub, or ~/.cache/huggingface/hub)
#   ms: $MODELSCOPE_CACHE/hub/models/org/name  (or hub/org/name, or ~/.cache/modelscope)

set -u

HUB_FZF_PLUGIN_DIR=${0:A:h:h}
source "$HUB_FZF_PLUGIN_DIR/lib/common.zsh"

zmodload -F zsh/stat b:zstat
zmodload zsh/datetime

source=${1:-hf}

# id <TAB> size <TAB> date; the pickers pad the id column (hub-fzf-pretty)
row() {  # <id> <dir>
  printf '%s\t%8s\t%s\n' "$1" "$(du -sh -- "$2" 2>/dev/null | cut -f1)" \
    "$(strftime '%Y-%m-%d' $(zstat +mtime -- "$2" 2>/dev/null || print 0))"
}

case $source in
  hf)
    hub=${HF_HUB_CACHE:-${HF_HOME:-$HOME/.cache/huggingface}/hub}
    for d in "$hub"/models--*--*(N-/om); do
      id=${${d:t}#models--}
      row "${id//--//}" "$d"
    done
    ;;

  ms)
    root=${MODELSCOPE_CACHE:-$HOME/.cache/modelscope}
    typeset -A seen
    for d in "$root"/hub/models/*/*(N-/om) "$root"/hub/*/*(N-/om); do
      rel=${d#$root/hub/}
      rel=${rel#models/}
      [[ -n ${seen[$rel]-} || $rel != */* ]] && continue
      seen[$rel]=1
      row "$rel" "$d"
    done
    ;;
esac

